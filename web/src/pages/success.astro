---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Checkout Status — Cool, Calm & Karter"
  description="Check the status of your Cool, Calm & Karter checkout."
>
  <section class="checkout-return" aria-labelledby="success-heading">
    <h1 id="success-heading">Thank You!</h1>
    <p class="lede">We appreciate you shopping with Cool, Calm &amp; Karter.</p>

    <p id="checkout-status" class="status-text" role="status" aria-live="polite">
      Checking your order status&hellip;
    </p>

    <nav class="return-links" aria-label="Continue browsing">
      <a href="/">Home</a>
      <a href="/shop">Shop</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .checkout-return {
    max-width: 560px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
    text-align: center;
  }

  .checkout-return h1 {
    font-family: var(--font-display);
    color: var(--color-navy);
    font-size: 2.25rem;
    margin: 0 0 0.75rem;
  }

  .lede {
    font-size: 1.05rem;
    margin: 0 0 1.5rem;
  }

  .status-text {
    background: #fff;
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 2rem;
  }

  .return-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .return-links a {
    color: var(--color-coral);
    font-weight: 700;
    text-decoration: underline;
    padding: 0.25rem;
  }

  .return-links a:hover,
  .return-links a:focus-visible {
    color: #d94c36;
  }

  .return-links a:focus-visible {
    outline: 3px solid var(--color-navy);
    outline-offset: 2px;
  }
</style>

<script>
  import { verifyCheckoutSession } from '../lib/api';
  import { clearCart } from '../lib/cart';

  const statusEl = document.getElementById('checkout-status');

  function setStatus(message: string): void {
    if (statusEl) statusEl.textContent = message;
  }

  async function run(): Promise<void> {
    // Read-only: the session_id itself is only ever used to ask the
    // server to verify it — it's never displayed, stored, or logged.
    const params = new URLSearchParams(window.location.search);
    const sessionId = params.get('session_id');

    if (!sessionId) {
      setStatus('We could not find checkout information for this visit.');
      return;
    }

    setStatus('Verifying your payment…');

    // The only source of truth for whether an order is real: the backend
    // asking Stripe directly. A missing/invalid session, an unpaid or
    // incomplete session, a network failure, and a malformed API response
    // all resolve to the same { verified: false } shape here — none of
    // them ever reach the cart-clearing branch below.
    const result = await verifyCheckoutSession(sessionId);

    if (result.verified) {
      // Runs at most once per page load — this is the only place the cart
      // is ever cleared on this page, and only after server-confirmed
      // payment.
      clearCart();
      setStatus('Your order is confirmed! Thank you for shopping with Cool, Calm & Karter.');
    } else {
      setStatus(
        'We could not confirm your payment yet. If you completed checkout, this can take a moment — please check back shortly, or contact us if you need help.',
      );
    }
  }

  run();
</script>
