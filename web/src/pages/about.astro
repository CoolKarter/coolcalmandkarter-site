  }

  .about h1 {
    text-align: center;
    font-family: var(--font-display);
    color: var(--color-navy);
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .about p {
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 0 1.25rem;
  }

  .browse-button {
    display: inline-block;
    margin-top: 1rem;
    background-color: var(--color-coral);
    color: white;
    padding: 0.75rem 2rem;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 10px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .browse-button:hover,
  .browse-button:focus-visible {
    background-color: #d94c36;
  }
</style>
