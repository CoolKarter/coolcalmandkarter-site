---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import ProductLayout from '../../layouts/ProductLayout.astro';
import { resolveCoverImage } from '../../lib/images';
import { isStoreCheckoutEnabled } from '../../lib/store-status.js';

export async function getStaticPaths() {
  const books = await getCollection('books');
  return books.map((book) => ({
    params: { slug: book.id },
    props: { book, allBooks: books },
  }));
}

interface Props {
  book: CollectionEntry<'books'>;
  allBooks: CollectionEntry<'books'>[];
}

const { book, allBooks } = Astro.props;
const { data } = book;
const cover = resolveCoverImage(data.coverImage);
const priceDisplay = data.price != null ? `$${(data.price / 100).toFixed(2)}` : null;
const isAvailable = data.availability === 'available';
// checkoutEnabled is the per-book purchase gate; STORE_CHECKOUT_ENABLED is
// the store-wide one (temporary out-of-stock state — see
// server/lib/store-checkout-status.js and web/src/lib/store-status.js).
// A book must pass BOTH to show purchase controls. Neither is a security
// boundary — the backend independently enforces both requirements
// server-side and rejects any checkout attempt that doesn't meet them
// (see server/lib/validate-checkout-items.js and the STORE_CHECKOUT_ENABLED
// guard on POST /api/checkout/session in server.js), so this is purely a
// frontend availability signal.
const STORE_CHECKOUT_ENABLED = isStoreCheckoutEnabled(import.meta.env.PUBLIC_STORE_CHECKOUT_ENABLED);
const canAddToCart = data.checkoutEnabled && STORE_CHECKOUT_ENABLED;
const pageTitle = data.seoTitle ?? `${data.title} — Cool, Calm & Karter`;
const pageDescription = data.seoDescription ?? data.shortDescription ?? data.description;
const bestSellerSlug = 'black-puerto-rican-and-baby';
const isBestSeller = book.id === bestSellerSlug;

// Deterministic "Continue the Adventure" picks — same alphabetical order as
// the shop grid, excluding the current book, first 3. Never random, never
// re-shuffles on reload.
const relatedBooks = allBooks
  .filter((b) => b.id !== book.id)
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .slice(0, 3);
---

<ProductLayout title={pageTitle} description={pageDescription}>
  <article class="product">
    <div class="product-hero">
      <div class="product-cover">
        <div class="cover-stage">
          {isBestSeller && <span class="bestseller-badge">Best Seller</span>}
          <div class="cover-frame">
            <Image src={cover} alt={data.coverImageAlt} width={700} loading="eager" />
          </div>
        </div>
      </div>

      <div class="product-info">
        {data.hook && <p class="hook">{data.hook}</p>}
        <h1>{data.title}</h1>

        <div class="product-facts">
          {priceDisplay && <span class="fact-price">{priceDisplay}</span>}
          {data.ageRange && <span class="fact-age">Ages {data.ageRange}</span>}
          {
            data.rating != null && (
              <span class="fact-rating" aria-label={`Rated ${data.rating} out of 5`}>
                {'★'.repeat(Math.round(data.rating))}
                <span class="rating-number">{data.rating.toFixed(1)}</span>
              </span>
            )
          }
        </div>

        {data.shortDescription && <p class="short-description">{data.shortDescription}</p>}

        {
          canAddToCart ? (
            <div class="purchase-controls">
              <div class="quantity-stepper" role="group" aria-label={`Quantity for ${data.title}`}>
                <button type="button" id="qty-decrease" aria-label="Decrease quantity">
                  &minus;
                </button>
                <span id="qty-value" aria-live="polite">
                  1
                </span>
                <button type="button" id="qty-increase" aria-label="Increase quantity">
                  +
                </button>
              </div>
              <button
                type="button"
                class="buy-button"
                id="add-to-cart-button"
                data-slug={book.id}
                data-title={data.title}
              >
                Add to Cart &mdash; {priceDisplay}
              </button>
              <p id="add-to-cart-status" class="add-to-cart-status" role="status" aria-live="polite" />
            </div>
          ) : (
            <div class="out-of-stock" role="status">
              <p class="out-of-stock-label">Out of Stock</p>
              <p class="out-of-stock-copy">More copies coming soon.</p>
            </div>
          )
        }

        <a class="back-to-shop" href="/shop">&larr; Back to the Collection</a>
      </div>
    </div>

    <div class="product-details">
      <section class="detail-section" aria-labelledby="about-heading">
        <h2 id="about-heading" class="section-title section-title--left">About the Story</h2>
        <p>{data.description}</p>
      </section>

      {
        data.ageRange && (
          <section class="detail-section age-section" aria-labelledby="age-heading">
            <h2 id="age-heading" class="section-title section-title--left">
              Perfect for Ages {data.ageRange}
            </h2>
            <p>
              Written for little ears and growing hearts — simple, warm, and made for reading
              aloud together.
            </p>
          </section>
        )
      }

      {
        data.reviews && data.reviews.length > 0 && (
          <section class="reviews" aria-label="Reader reviews">
            <h2 class="section-title section-title--left">What Readers Are Saying</h2>
            <ul class="review-grid">
              {data.reviews.map((review) => (
                <li class="review-card">
                  <p>&ldquo;{review.quote}&rdquo;</p>
                  {review.author && <cite>&mdash; {review.author}</cite>}
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    {
      relatedBooks.length > 0 && (
        <section class="related" aria-labelledby="related-heading">
          <p class="section-eyebrow">Keep the story going</p>
          <h2 id="related-heading" class="section-title">
            Continue the Adventure
          </h2>
          <ul class="related-grid">
            {relatedBooks.map((related) => (
              <li>
                <a class="related-card" href={`/books/${related.id}`}>
                  <div class="related-cover cover-frame">
                    <Image
                      src={resolveCoverImage(related.data.coverImage)}
                      alt={related.data.coverImageAlt}
                      width={320}
                      loading="lazy"
                    />
                  </div>
                  <span class="related-title">{related.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="related-all" href="/shop">
            See the Full Collection
          </a>
        </section>
      )
    }
  </article>
</ProductLayout>

<style>
  .product {
    /* .product is a flex item of the shared <main> (see tokens.css's
       main { display: flex; flex-direction: column; }). In a column flex
       container, width is a CROSS-axis property governed by
       align-items: stretch by default — but stretch is disabled whenever
       an item has an auto cross-axis margin (margin: 0 auto below, the
       standard centering pattern), so without an explicit width the
       browser falls back to sizing .product from its own CONTENT's
       preferred width instead of the available viewport width. The
       max-width below then simply caps that (already too-wide) preferred
       size rather than constraining it to the viewport, which is what
       actually pushed this whole page wider than 320px on mobile.
       width: 100% restores the intended behavior: fill the available
       width up to max-width, then the auto margins center it once the
       viewport exceeds max-width. */
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 3.5rem) 1.5rem 1rem;
  }

  /* ---- Above-the-fold hero ---- */

  .product-hero {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    background: #fff;
    border-radius: 24px;
    padding: clamp(1.75rem, 4vw, 3rem);
    box-shadow:
      0 2px 8px rgba(25, 85, 105, 0.06),
      0 30px 60px -34px rgba(25, 85, 105, 0.4);
  }

  @media (min-width: 750px) {
    .product-hero {
      grid-template-columns: minmax(280px, 380px) 1fr;
      align-items: center;
    }
  }

  .product-cover {
    display: flex;
    justify-content: center;
  }

  .cover-stage {
    position: relative;
    width: 100%;
    max-width: 340px;
  }

  /* Soft halo behind the cover — pure CSS, never competes with the art. */
  .cover-stage::before {
    content: '';
    position: absolute;
    inset: -6%;
    background: radial-gradient(closest-side, rgba(244, 220, 174, 0.4), transparent 72%);
    z-index: 0;
    pointer-events: none;
  }

  .cover-stage .cover-frame {
    position: relative;
    z-index: 1;
    box-shadow:
      0 3px 10px rgba(25, 85, 105, 0.08),
      0 26px 44px -18px rgba(25, 85, 105, 0.45);
  }

  .bestseller-badge {
    position: absolute;
    top: -0.8rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    background: linear-gradient(90deg, var(--color-coral), #f97f52);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.28rem 1rem;
    border-radius: 999px;
    box-shadow: 0 6px 14px -6px rgba(244, 96, 69, 0.7);
    white-space: nowrap;
  }

  .product-info h1 {
    font-family: var(--font-headline);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-navy);
    font-size: clamp(1.9rem, 3.6vw, 2.6rem);
    line-height: 1.12;
    margin: 0 0 0.6rem;
  }

  .hook {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-coral);
    margin: 0 0 0.5rem;
  }

  .product-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin: 0 0 1.1rem;
  }

  .fact-price {
    font-weight: 800;
    color: var(--color-navy);
    font-size: 1.3rem;
  }

  .fact-age {
    font-weight: 700;
    color: #5b7381;
    background: rgba(25, 85, 105, 0.08);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.9rem;
  }

  .fact-rating {
    color: #e8a33d;
    font-size: 1rem;
    letter-spacing: 0.05em;
  }

  .rating-number {
    color: #5b7381;
    font-size: 0.85rem;
    letter-spacing: normal;
    margin-left: 0.35rem;
  }

  .short-description {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #3a3a3a;
    margin: 0 0 1.6rem;
    max-width: 34rem;
  }

  .purchase-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .quantity-stepper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-cream-light);
    border-radius: 999px;
    padding: 0.35rem 0.5rem;
  }

  .quantity-stepper button {
    width: 2rem;
    height: 2rem;
    border: none;
    background: #fff;
    color: var(--color-navy);
    border-radius: 50%;
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(25, 85, 105, 0.2);
    transition: background-color 0.15s ease;
  }

  .quantity-stepper button:hover,
  .quantity-stepper button:focus-visible {
    background: var(--color-cream);
  }

  .quantity-stepper button:focus-visible {
    outline: 3px solid var(--color-navy);
    outline-offset: 2px;
  }

  .quantity-stepper span {
    min-width: 1.5rem;
    text-align: center;
    font-weight: 700;
    color: var(--color-navy);
  }

  .buy-button {
    background-color: var(--color-coral);
    color: white;
    border: none;
    padding: 0.85rem 1.9rem;
    font-size: 1.05rem;
    font-weight: 700;
    font-family: var(--font-heading);
    border-radius: 999px;
    cursor: pointer;
    box-shadow:
      0 12px 26px -12px rgba(244, 96, 69, 0.65),
      0 3px 8px rgba(25, 85, 105, 0.2);
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .buy-button:hover,
  .buy-button:focus-visible {
    background-color: var(--color-coral-deep);
    transform: translateY(-1px);
  }

  .buy-button:focus-visible {
    outline: 3px solid var(--color-navy);
    outline-offset: 3px;
  }

  .add-to-cart-status {
    flex-basis: 100%;
    margin: 0;
    font-weight: 700;
    color: #1a7a3c;
    min-height: 1.2em;
  }

  .out-of-stock {
    display: inline-flex;
    flex-direction: column;
    gap: 0.2rem;
    background: rgba(25, 85, 105, 0.08);
    padding: 0.85rem 1.25rem;
    border-radius: 12px;
    margin: 0 0 0.75rem;
  }

  .out-of-stock-label {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-coral-deep);
  }

  .out-of-stock-copy {
    margin: 0;
    font-size: 0.92rem;
    color: #4a4a4a;
  }

  .back-to-shop {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--color-navy);
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .back-to-shop:hover,
  .back-to-shop:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ---- Below-the-fold detail sections ---- */

  .product-details {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 2.75rem);
  }

  .detail-section h2,
  .reviews h2,
  .related h2 {
    color: var(--color-navy);
  }

  .detail-section h2 {
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    margin: 0 0 0.9rem;
  }

  .detail-section p {
    font-size: 1.02rem;
    line-height: 1.75;
    color: #3a3a3a;
    margin: 0;
    max-width: 42rem;
  }

  .age-section {
    background: var(--color-cream-light);
    border-radius: 18px;
    padding: 1.5rem 1.75rem;
  }

  .age-section p {
    color: #33586a;
  }

  .reviews h2 {
    font-size: clamp(1.4rem, 2.4vw, 1.75rem);
    margin: 0 0 1.3rem;
  }

  .review-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .review-card {
    background: #fff;
    border-radius: 16px;
    padding: 1.25rem 1.4rem;
    box-shadow:
      0 2px 6px rgba(25, 85, 105, 0.06),
      0 14px 28px -20px rgba(25, 85, 105, 0.35);
  }

  .review-card p {
    font-style: italic;
    color: #3a3a3a;
    line-height: 1.6;
    margin: 0 0 0.6rem;
  }

  .review-card cite {
    font-size: 0.85rem;
    color: #5b7381;
    font-style: normal;
    font-weight: 700;
  }

  /* ---- Related books ---- */

  .related {
    margin-top: clamp(3rem, 7vw, 4rem);
    padding: clamp(2rem, 5vw, 3rem) 0 1rem;
    border-top: 1px solid rgba(25, 85, 105, 0.15);
    text-align: center;
  }

  .section-eyebrow {
    font-family: var(--font-display);
    color: var(--color-coral);
    font-size: 1.05rem;
    margin: 0 0 0.4rem;
  }

  .related h2 {
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    margin: 0 0 2rem;
  }

  .related-grid {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 1.5rem;
    max-width: 640px;
    margin-inline: auto;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
    border-radius: 14px;
    padding: 0.75rem;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .related-card:hover,
  .related-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 14px 26px -18px rgba(25, 85, 105, 0.5);
  }

  .related-card:focus-visible {
    outline: 3px solid var(--color-navy);
    outline-offset: 2px;
  }

  .related-cover {
    width: 100%;
    max-width: 150px;
    margin-bottom: 0.75rem;
  }

  .related-title {
    font-family: var(--font-headline);
    font-weight: 600;
    color: var(--color-navy);
    font-size: 0.98rem;
    line-height: 1.3;
  }

  .related-all {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: #fff;
    background-color: var(--color-navy);
    padding: 0.65rem 1.75rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .related-all:hover,
  .related-all:focus-visible {
    background-color: #123f4d;
  }

  .related-all:focus-visible {
    outline: 3px solid var(--color-navy);
    outline-offset: 3px;
  }
</style>

<script>
  import { addToCart } from '../../lib/cart';

  const button = document.getElementById('add-to-cart-button');
  const status = document.getElementById('add-to-cart-status');
  const qtyValue = document.getElementById('qty-value');
  const qtyDecrease = document.getElementById('qty-decrease');
  const qtyIncrease = document.getElementById('qty-increase');

  const MAX_QUANTITY = 20;
  let quantity = 1;

  function renderQuantity(): void {
    if (qtyValue) qtyValue.textContent = String(quantity);
    if (qtyDecrease) (qtyDecrease as HTMLButtonElement).disabled = quantity <= 1;
    if (qtyIncrease) (qtyIncrease as HTMLButtonElement).disabled = quantity >= MAX_QUANTITY;
  }

  qtyDecrease?.addEventListener('click', () => {
    quantity = Math.max(1, quantity - 1);
    renderQuantity();
  });

  qtyIncrease?.addEventListener('click', () => {
    quantity = Math.min(MAX_QUANTITY, quantity + 1);
    renderQuantity();
  });

  button?.addEventListener('click', () => {
    const slug = button.getAttribute('data-slug');
    const title = button.getAttribute('data-title') ?? 'Item';
    if (!slug) return;

    addToCart(slug, quantity);

    if (status) {
      status.textContent =
        quantity === 1
          ? `${title} added to your cart.`
          : `${quantity} × ${title} added to your cart.`;
    }

    quantity = 1;
    renderQuantity();
  });

  renderQuantity();
</script>
