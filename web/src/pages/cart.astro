---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import { resolveCoverImage } from '../lib/images';
import { visualAssets } from '../data/visualAssets';
import { isStoreCheckoutEnabled } from '../lib/store-status.js';

// Store-wide checkout kill-switch (temporary out-of-stock state) — see
// server/lib/store-checkout-status.js and web/src/lib/store-status.js.
// A customer's saved cart is NEVER cleared because of this — see the
// client script below, which only disables the Checkout action itself.
const STORE_CHECKOUT_ENABLED = isStoreCheckoutEnabled(import.meta.env.PUBLIC_STORE_CHECKOUT_ENABLED);

// Only checkoutEnabled books get a catalog entry here. If a non-purchasable
// slug ever ends up in localStorage (e.g. via manual devtools edits), the
// client script below simply won't find it in this catalog and will ignore
// it. The backend independently enforces the real requirement (a
// configured Stripe Price ID) server-side regardless of this flag — see
// server/lib/validate-checkout-items.js.
const purchasableBooks = (await getCollection('books')).filter((book) => book.data.checkoutEnabled);

const catalog = await Promise.all(
  purchasableBooks.map(async (book) => {
    const cover = resolveCoverImage(book.data.coverImage);
    // Sized for the larger premium cart thumbnail (~110px display width) at
    // a crisp density, not just the old 64px thumbnail.
    const optimized = await getImage({ src: cover, width: 220 });
    return {
      slug: book.id,
      title: book.data.title,
      price: book.data.price ?? 0,
      imageSrc: optimized.src,
      imageAlt: book.data.coverImageAlt,
    };
  }),
);

// Defensive escaping so no book title could ever break out of the inline
// JSON <script> tag (all our own trusted copy today, but cheap to guard).
const catalogJson = JSON.stringify(catalog).replace(/</g, '\\u003c');
---

<BaseLayout
  title="Your Cart — Cool, Calm & Karter"
  description="Review the books in your Cool, Calm & Karter cart."
>
  <section class="cart-hero" aria-labelledby="cart-heading">
    <img
      class="cart-hero-bg"
      src={visualAssets.backgrounds.storySection}
      alt=""
      aria-hidden="true"
      loading="eager"
      width="1916"
      height="821"
    />
    <div class="cart-hero-scrim" aria-hidden="true"></div>
    <div class="cart-hero-inner">
      <p class="cart-eyebrow">Your Collection</p>
      <h1 id="cart-heading" class="section-title">Your Cart</h1>
    </div>
  </section>

  <p id="cart-live-region" class="visually-hidden" role="status" aria-live="polite"></p>

  {/* Cream working area, independent of the hero (never touching it). When
      empty, the card centers vertically within this flexible region; when
      populated, items flow normally from the top with breathing room
      beneath the hero — see the .cart-page / #cart-empty rules below. */}
  <div class="cart-page">
    <div id="cart-empty" class="cart-empty" hidden>
      <img
        class="empty-cart-karter"
        src={visualAssets.characters.peeking}
        alt=""
        aria-hidden="true"
        loading="lazy"
        width="1024"
        height="1536"
      />
      <p class="cart-eyebrow">Your next story is waiting</p>
      <h2 class="section-title">Your Cart Is Empty</h2>
      <p class="empty-cart-copy">
        Browse the collection and find the next book your little one will ask for again and
        again.
      </p>
      <a class="cta-button" href="/shop">Explore the Books</a>
    </div>

    <div
      id="cart-summary"
      class="cart-summary"
      hidden
      data-store-checkout-enabled={STORE_CHECKOUT_ENABLED ? 'true' : 'false'}
    >
      <div class="cart-items-column">
        <ul id="cart-items" class="cart-items"></ul>
      </div>

      <div class="cart-summary-column">
        <div id="order-summary" class="order-summary">
          <div class="order-summary-row">
            <span class="order-summary-label">Total</span>
            <span id="cart-total" class="order-summary-total">$0.00</span>
          </div>
          <button type="button" id="checkout-button" class="checkout-button">Checkout</button>
          <p id="checkout-status" class="checkout-status" role="status" aria-live="polite"></p>
        </div>
      </div>
    </div>
  </div>

  <div id="sticky-checkout-bar" class="sticky-checkout-bar" aria-hidden="true">
    <div class="sticky-total">
      <span class="sticky-total-label">Total</span>
      <span id="sticky-cart-total" class="sticky-total-amount">$0.00</span>
    </div>
    <button type="button" id="sticky-checkout-button" class="checkout-button sticky-checkout-cta">
      Checkout
    </button>
    <p id="sticky-checkout-status" class="visually-hidden" role="status" aria-live="polite"></p>
  </div>

  <script type="application/json" id="cart-catalog" set:html={catalogJson} />
</BaseLayout>

<style>
  /* Independent cream working area — never touches the hero above it.
     flex:1 lets it absorb any leftover viewport height on short pages
     (main is the flex column this grows within); display:flex plus the
     `margin: auto` trick on #cart-empty (below) centers that single card
     vertically within this region without affecting #cart-summary, which
     has no such margin and simply flows from the top as normal. */
  .cart-page {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 2.75rem) 1.5rem 4rem;
    width: 100%;
  }

  /* At tablet-large/desktop widths, the page itself widens to make room
     for a two-column layout (items left, order summary right) — below
     this, .cart-page stays at its original narrow single-column width, so
     mobile/tablet are completely unaffected by anything in this block. */
  @media (min-width: 900px) {
    .cart-page {
      max-width: 1180px;
    }
  }

  /* ---- Cinematic hero header — same cloud asset + scrim strategy as the
     Shop hero, kept compact since this is a purchase-adjacent page. ---- */

  .cart-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-night);
    padding: clamp(2.25rem, 6vw, 3rem) 1.5rem clamp(2.5rem, 6vw, 3.25rem);
    text-align: center;
    color: #fff;
  }

  .cart-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .cart-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      165deg,
      rgba(9, 26, 43, 0.88) 0%,
      rgba(15, 44, 64, 0.82) 55%,
      rgba(25, 85, 105, 0.75) 100%
    );
  }

  .cart-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin: 0 auto;
  }

  .cart-hero-inner .cart-eyebrow {
    color: #ffdcae;
  }

  .cart-hero-inner .section-title {
    color: #fff;
    font-size: clamp(1.9rem, 4vw, 2.4rem);
    margin: 0;
  }

  .cart-eyebrow {
    font-family: var(--font-display);
    color: var(--color-coral);
    font-size: 1.05rem;
    margin: 0 0 0.35rem;
  }

  /* ---- Empty state: a clean white card, sitting fully independent of the
     hero — centered vertically within the flexible cream region above via
     `margin: auto` (a column-flex item with auto top+bottom margins
     centers itself in the leftover space; #cart-summary has no such
     margin, so it is unaffected and flows from the top as normal). ---- */

  .cart-empty {
    position: relative;
    overflow: visible;
    text-align: center;
    background: #fff;
    max-width: 32rem;
    margin: auto auto;
    padding: clamp(2.25rem, 6vw, 3rem) 1.75rem clamp(2rem, 5vw, 2.5rem);
    border-radius: 20px;
    box-shadow:
      0 10px 30px rgba(4, 10, 18, 0.35),
      0 26px 48px -20px rgba(4, 10, 18, 0.45);
  }

  /* Restrained peek from the card's own corner — the card no longer
     touches the hero, so he just peeks in from its top edge. */
  .empty-cart-karter {
    position: absolute;
    top: -2.5rem;
    right: 6%;
    width: clamp(72px, 11vw, 100px);
    height: auto;
    pointer-events: none;
  }

  @media (max-width: 480px) {
    .empty-cart-karter {
      top: -1.9rem;
      right: 4%;
      width: 68px;
    }
  }

  .cart-empty .cart-eyebrow {
    margin-top: 0.5rem;
  }

  .cart-empty .section-title {
    color: var(--color-navy);
    font-size: clamp(1.6rem, 3.4vw, 2rem);
    margin: 0 0 0.9rem;
  }

  .empty-cart-copy {
    max-width: 30rem;
    margin: 0 auto 1.75rem;
    font-size: 1.02rem;
    line-height: 1.65;
    color: #4a4a4a;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: #fff;
    background-color: var(--color-coral);
    padding: 0.75rem 2.1rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow:
      0 14px 28px -14px rgba(244, 96, 69, 0.65),
      0 3px 8px rgba(25, 85, 105, 0.2);
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .cta-button:hover,
  .cta-button:focus-visible {
    background-color: var(--color-coral-deep);
    transform: translateY(-1px);
  }

  .cta-button:focus-visible {
    outline: 3px solid var(--color-navy);
    outline-offset: 3px;
  }

  /* ---- Cart layout: items + order summary ----
     Below 900px this is a plain single column (.cart-items-column and
     .cart-summary-column are unstyled divs, stacking normally — the
     original, unchanged mobile/tablet behavior). At 900px+, it becomes a
     two-column layout with a sticky summary — see the `min-width: 900px`
     block below — so the Checkout button/total stay visible while
     scrolling a long item list instead of sitting below all 12 books. */

  /* No `display` set here on purpose — this element toggles via the
     `hidden` attribute, and any author `display` value here would win over
     the browser's default `[hidden] { display: none }` rule and defeat it. */
  .cart-summary:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .cart-summary:not([hidden]) {
      flex-direction: row;
      align-items: flex-start;
      gap: 2rem;
    }

    .cart-items-column {
      flex: 1 1 auto;
      min-width: 0; /* lets long titles wrap instead of forcing the column wider */
    }

    .cart-summary-column {
      flex: 0 0 320px;
      /* Sticky, not fixed: stays pinned within the height of its own
         parent (.cart-summary) — once the items column finishes scrolling
         past, it scrolls away normally with the rest of the page instead
         of floating over the footer. Nav.astro is not itself
         fixed/sticky, so `top` here is simply breathing room from the
         viewport edge, not compensating for a persistent header. */
      position: sticky;
      top: 1.5rem;
    }
  }

  .cart-items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  @media (min-width: 900px) {
    .cart-items {
      gap: 0.65rem;
    }
  }

  :global(.cart-item) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'cover details actions';
    gap: 1.1rem;
    align-items: center;
    background: #fff;
    padding: 1rem;
    border-radius: 16px;
    box-shadow:
      0 2px 6px rgba(25, 85, 105, 0.06),
      0 16px 30px -24px rgba(25, 85, 105, 0.4);
  }

  :global(.cart-item-cover) {
    grid-area: cover;
    width: clamp(90px, 16vw, 112px);
    margin: 0;
  }

  :global(.cart-item-details) {
    grid-area: details;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  :global(.cart-item-actions) {
    grid-area: actions;
  }

  /* Below ~560px, the title column gets crowded next to the quantity
     stepper. Actions drop to their own full-width row so the title always
     has room to read on one or two lines instead of wrapping awkwardly. */
  @media (max-width: 560px) {
    :global(.cart-item) {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'cover details'
        'actions actions';
      row-gap: 0.85rem;
    }

    :global(.cart-item-actions) {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }

    :global(.remove-button) {
      margin-top: 0;
    }
  }

  :global(.cart-item-title) {
    font-family: var(--font-headline);
    font-weight: 600;
    font-size: 1.08rem;
    line-height: 1.25;
    color: var(--color-navy);
    text-decoration: none;
  }

  :global(.cart-item-title:hover),
  :global(.cart-item-title:focus-visible) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  :global(.cart-item-price) {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  :global(.cart-item-actions) {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.65rem;
  }

  :global(.quantity-stepper) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  :global(.quantity-stepper button) {
    width: 2.25rem;
    height: 2.25rem;
    border: none;
    background: var(--color-cream-light);
    color: var(--color-navy);
    border-radius: 50%;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(25, 85, 105, 0.2);
    transition: background-color 0.15s ease;
  }

  :global(.quantity-stepper button:hover) {
    background: var(--color-cream);
  }

  :global(.quantity-stepper button:focus-visible) {
    outline: 3px solid var(--color-navy);
    outline-offset: 2px;
  }

  :global(.quantity-stepper span) {
    min-width: 1.4rem;
    text-align: center;
    font-weight: 700;
    color: var(--color-navy);
  }

  :global(.cart-item-subtotal) {
    margin: 0;
    font-weight: 700;
    color: var(--color-navy);
    font-size: 0.95rem;
  }

  :global(.remove-button) {
    background: none;
    border: none;
    color: var(--color-coral);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    padding: 0.2rem 0;
    margin-top: 0.2rem;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  :global(.remove-button:hover),
  :global(.remove-button:focus-visible) {
    color: var(--color-coral-deep);
  }

  :global(.remove-button:focus-visible) {
    outline: 3px solid var(--color-navy);
    outline-offset: 2px;
    border-radius: 4px;
  }

  @media (max-width: 640px) {
    :global(.quantity-stepper button) {
      width: 2.75rem;
      height: 2.75rem;
      font-size: 1.25rem;
    }
  }

  /* Compact desktop row: cover + title + quantity + subtotal + remove all
     inline in one shorter row, instead of the taller cover-details-actions
     layout used everywhere below 900px (tablet/mobile are untouched — see
     the `min-width: 900px` gate). This is what lets meaningfully more
     books fit in the viewport at once alongside the sticky summary panel;
     a 2-column item grid was evaluated and deliberately not used — at the
     item-column's actual available width once the summary panel takes its
     320px, splitting into two columns left too little room for the
     quantity stepper and Remove action to stay comfortably clickable, so
     a single compact column was the cleaner result in visual QA. */
  @media (min-width: 900px) {
    :global(.cart-item) {
      grid-template-columns: 64px 1fr auto auto auto;
      grid-template-areas: 'cover details quantity subtotal remove';
      column-gap: 1.1rem;
      padding: 0.6rem 1rem;
    }

    :global(.cart-item-cover) {
      width: 64px;
    }

    :global(.cart-item-cover.cover-frame) {
      padding: 0.35rem;
    }

    :global(.cart-item-title) {
      font-size: 1rem;
    }

    :global(.cart-item-price) {
      font-size: 0.88rem;
    }

    /* Unwraps .cart-item-actions so its three children become direct grid
       items of .cart-item itself, each placed into its own named area —
       no JS/markup change needed, since quantity-stepper/cart-item-subtotal/
       remove-button already carry their own distinct classes. */
    :global(.cart-item-actions) {
      display: contents;
    }

    :global(.quantity-stepper) {
      grid-area: quantity;
    }

    :global(.cart-item-subtotal) {
      grid-area: subtotal;
      min-width: 4.25rem;
      text-align: right;
    }

    :global(.remove-button) {
      grid-area: remove;
      margin-top: 0;
    }
  }

  /* ---- Order summary ---- */

  .order-summary {
    background: var(--color-cream-light);
    border-radius: 18px;
    padding: 1.5rem 1.5rem 1.75rem;
  }

  .order-summary-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.25rem;
  }

  .order-summary-label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-navy);
  }

  .order-summary-total {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: clamp(1.9rem, 4vw, 2.3rem);
    color: var(--color-navy);
  }

  .checkout-button {
    display: block;
    width: 100%;
    background-color: var(--color-coral);
    color: white;
    border: none;
    padding: 1rem;
    font-size: 1.1rem;
    font-weight: 700;
    font-family: var(--font-heading);
    border-radius: 999px;
    cursor: pointer;
    box-shadow:
      0 14px 30px -14px rgba(244, 96, 69, 0.65),
      0 3px 8px rgba(25, 85, 105, 0.2);
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .checkout-button:hover,
  .checkout-button:focus-visible {
    background-color: var(--color-coral-deep);
    transform: translateY(-1px);
  }

  .checkout-button:focus-visible {
    outline: 3px solid var(--color-navy);
    outline-offset: 3px;
  }

  .checkout-button:disabled {
    background-color: #ccc;
    color: #555;
    cursor: not-allowed;
    opacity: 0.85;
    box-shadow: none;
    transform: none;
  }

  .checkout-status {
    margin: 0.85rem 0 0;
    text-align: center;
    font-weight: 700;
    min-height: 1.2em;
    color: var(--color-navy);
  }

  .checkout-status.error {
    color: #b3261e;
  }

  /* ---- Mobile sticky checkout bar ---- */

  .sticky-checkout-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    display: none;
    align-items: center;
    gap: 1rem;
    background: #fff;
    padding: 0.85rem 1.1rem calc(0.85rem + env(safe-area-inset-bottom, 0px));
    box-shadow: 0 -6px 24px rgba(9, 26, 43, 0.18);
    transform: translateY(100%);
    pointer-events: none;
  }

  .sticky-checkout-bar.is-shown {
    transform: translateY(0);
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sticky-checkout-bar {
      transition: transform 0.25s ease;
    }
  }

  .sticky-total {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    flex-shrink: 0;
  }

  .sticky-total-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #5b7381;
    font-weight: 700;
  }

  .sticky-total-amount {
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--color-navy);
  }

  .sticky-checkout-cta {
    width: auto;
    flex: 1;
    padding: 0.8rem 1.5rem;
    font-size: 1rem;
  }

  @media (max-width: 760px) {
    .sticky-checkout-bar {
      display: flex;
    }

    /* Room so the fixed bar never covers the last item in a short cart. */
    .cart-page {
      padding-bottom: 6rem;
    }
  }
</style>

<script>
  import {
    readCart,
    setQuantity,
    removeFromCart,
    CART_STORAGE_KEY,
    CART_UPDATED_EVENT,
  } from '../lib/cart';
  import { createCheckoutSession } from '../lib/api';

  interface CatalogEntry {
    slug: string;
    title: string;
    price: number;
    imageSrc: string;
    imageAlt: string;
  }

  const catalogScript = document.getElementById('cart-catalog');
  const catalog: CatalogEntry[] = catalogScript ? JSON.parse(catalogScript.textContent ?? '[]') : [];
  const catalogMap = new Map(catalog.map((entry) => [entry.slug, entry]));

  const itemsContainer = document.getElementById('cart-items');
  const emptyState = document.getElementById('cart-empty');
  const summarySection = document.getElementById('cart-summary');
  const totalEl = document.getElementById('cart-total');
  const stickyTotalEl = document.getElementById('sticky-cart-total');
  const liveRegion = document.getElementById('cart-live-region');

  // Store-wide checkout kill-switch (see cart.astro's frontmatter and
  // server/lib/store-checkout-status.js). Read once from the data
  // attribute rendered at build time — this only ever disables the
  // Checkout action below; it never touches readCart()/localStorage, so a
  // customer's saved selection is preserved untouched until inventory
  // returns.
  const storeCheckoutEnabled = summarySection?.dataset.storeCheckoutEnabled === 'true';

  function formatPrice(cents: number): string {
    return `$${(cents / 100).toFixed(2)}`;
  }

  function announce(message: string): void {
    if (liveRegion) liveRegion.textContent = message;
  }

  function render(): void {
    if (!itemsContainer || !emptyState || !summarySection || !totalEl) return;

    const rawCart = readCart();

    // Self-heal: a slug that isn't in the purchasable catalog (e.g. one of
    // the 7 non-purchasable books, however it got there) never renders and
    // is pruned from storage so the nav badge count stays accurate too.
    // Written directly (not via addToCart/removeFromCart) so it doesn't
    // dispatch CART_UPDATED_EVENT and re-enter this same render() call.
    let needsPrune = false;
    const cart: typeof rawCart = {};
    for (const [slug, quantity] of Object.entries(rawCart)) {
      if (catalogMap.has(slug)) {
        cart[slug] = quantity;
      } else {
        needsPrune = true;
      }
    }
    if (needsPrune) {
      window.localStorage.setItem(CART_STORAGE_KEY, JSON.stringify(cart));
    }

    const entries = Object.entries(cart)
      .map(([slug, quantity]) => ({ slug, quantity, product: catalogMap.get(slug) }))
      .filter((entry): entry is { slug: string; quantity: number; product: CatalogEntry } =>
        Boolean(entry.product) && entry.quantity > 0,
      );

    itemsContainer.innerHTML = '';

    if (entries.length === 0) {
      emptyState.hidden = false;
      summarySection.hidden = true;
      hideStickyBar();
      return;
    }

    emptyState.hidden = true;
    summarySection.hidden = false;

    let total = 0;

    for (const { slug, quantity, product } of entries) {
      const subtotal = product.price * quantity;
      total += subtotal;

      const li = document.createElement('li');
      li.className = 'cart-item';

      const coverFrame = document.createElement('div');
      coverFrame.className = 'cart-item-cover cover-frame';
      const img = document.createElement('img');
      img.src = product.imageSrc;
      img.alt = product.imageAlt;
      img.width = 220;
      img.height = 275;
      coverFrame.appendChild(img);

      const details = document.createElement('div');
      details.className = 'cart-item-details';
      const titleLink = document.createElement('a');
      titleLink.className = 'cart-item-title';
      titleLink.href = `/books/${slug}`;
      titleLink.textContent = product.title;
      const priceEl = document.createElement('p');
      priceEl.className = 'cart-item-price';
      priceEl.textContent = `${formatPrice(product.price)} each`;
      details.append(titleLink, priceEl);

      const actions = document.createElement('div');
      actions.className = 'cart-item-actions';

      const quantityRow = document.createElement('div');
      quantityRow.className = 'quantity-stepper';
      quantityRow.setAttribute('role', 'group');
      quantityRow.setAttribute('aria-label', `Quantity for ${product.title}`);

      const decreaseButton = document.createElement('button');
      decreaseButton.type = 'button';
      decreaseButton.textContent = '−';
      decreaseButton.setAttribute('aria-label', `Decrease quantity of ${product.title}`);
      decreaseButton.addEventListener('click', () => {
        const next = quantity - 1;
        setQuantity(slug, next);
        announce(
          next <= 0
            ? `${product.title} removed from cart.`
            : `Quantity for ${product.title} updated to ${next}.`,
        );
        render();
      });

      const quantityLabel = document.createElement('span');
      quantityLabel.textContent = String(quantity);
      quantityLabel.setAttribute('aria-label', `Quantity of ${product.title}: ${quantity}`);

      const increaseButton = document.createElement('button');
      increaseButton.type = 'button';
      increaseButton.textContent = '+';
      increaseButton.setAttribute('aria-label', `Increase quantity of ${product.title}`);
      increaseButton.addEventListener('click', () => {
        const next = quantity + 1;
        setQuantity(slug, next);
        announce(`Quantity for ${product.title} updated to ${next}.`);
        render();
      });

      quantityRow.append(decreaseButton, quantityLabel, increaseButton);

      const subtotalEl = document.createElement('p');
      subtotalEl.className = 'cart-item-subtotal';
      subtotalEl.textContent = formatPrice(subtotal);

      const removeButton = document.createElement('button');
      removeButton.type = 'button';
      removeButton.className = 'remove-button';
      removeButton.textContent = 'Remove';
      removeButton.setAttribute('aria-label', `Remove ${product.title} from cart`);
      removeButton.addEventListener('click', () => {
        removeFromCart(slug);
        announce(`${product.title} removed from cart.`);
        render();
      });

      actions.append(quantityRow, subtotalEl, removeButton);
      li.append(coverFrame, details, actions);
      itemsContainer.appendChild(li);
    }

    const totalText = formatPrice(total);
    totalEl.textContent = totalText;
    if (stickyTotalEl) stickyTotalEl.textContent = totalText;

    updateStickyVisibility();
  }

  render();
  window.addEventListener(CART_UPDATED_EVENT, render);

  // ---- Checkout: one shared handler for the in-panel button and the
  // mobile sticky bar button. No business logic is duplicated — both
  // buttons trigger this exact same function, which mirrors its
  // loading/error state to whichever status element(s) exist. ----

  const checkoutButton = document.getElementById('checkout-button') as HTMLButtonElement | null;
  const checkoutStatus = document.getElementById('checkout-status');
  const stickyCheckoutButton = document.getElementById(
    'sticky-checkout-button',
  ) as HTMLButtonElement | null;
  const stickyCheckoutStatus = document.getElementById('sticky-checkout-status');

  function setCheckoutBusy(busy: boolean): void {
    // Out of stock always wins — never re-enable the button just because
    // a (guarded-against, but defensive) checkout attempt finished.
    const disabled = busy || !storeCheckoutEnabled;
    if (checkoutButton) checkoutButton.disabled = disabled;
    if (stickyCheckoutButton) stickyCheckoutButton.disabled = disabled;
  }

  function setCheckoutMessage(message: string, isError: boolean): void {
    for (const el of [checkoutStatus, stickyCheckoutStatus]) {
      if (!el) continue;
      el.textContent = message;
      el.classList.toggle('error', isError);
    }
  }

  if (!storeCheckoutEnabled) {
    if (checkoutButton) {
      checkoutButton.disabled = true;
      checkoutButton.textContent = 'Out of Stock';
    }
    if (stickyCheckoutButton) {
      stickyCheckoutButton.disabled = true;
      stickyCheckoutButton.textContent = 'Out of Stock';
    }
    // checkout-status is a normal visible line under the full Checkout
    // button; sticky-checkout-status is intentionally screen-reader-only
    // (see its visually-hidden class) since the compact mobile bar has no
    // room for a second visible line — the button's own "Out of Stock"
    // label already communicates this visually there.
    if (checkoutStatus) checkoutStatus.textContent = 'Out of Stock. More copies coming soon.';
    if (stickyCheckoutStatus) stickyCheckoutStatus.textContent = 'Out of Stock. More copies coming soon.';
  }

  async function performCheckout(): Promise<void> {
    // Belt-and-suspenders: the buttons above are already disabled (so a
    // real click can't reach this), and the backend independently refuses
    // to create a Checkout Session regardless of this flag — see
    // server.js's STORE_CHECKOUT_ENABLED guard. This just avoids a
    // pointless network round-trip if something (e.g. a programmatic
    // click) ever bypassed the disabled attribute.
    if (!storeCheckoutEnabled) return;

    // Only slug + quantity ever leave the browser — no Stripe Price ID,
    // title, or price. The server resolves all of that itself from its
    // own catalog (see server/lib/validate-checkout-items.js).
    const cart = readCart();
    const items = Object.entries(cart)
      .filter(([slug, quantity]) => catalogMap.has(slug) && quantity > 0)
      .map(([slug, quantity]) => ({ slug, quantity }));

    if (items.length === 0) {
      return;
    }

    setCheckoutBusy(true);
    setCheckoutMessage('Redirecting to secure checkout…', false);

    try {
      const url = await createCheckoutSession(items);
      // Cart is intentionally left untouched here — it only clears once
      // an order is verified as complete, which isn't wired up yet.
      window.location.href = url;
    } catch (error) {
      setCheckoutBusy(false);
      setCheckoutMessage(
        error instanceof Error ? error.message : 'Something went wrong. Please try again.',
        true,
      );
    }
  }

  checkoutButton?.addEventListener('click', performCheckout);
  stickyCheckoutButton?.addEventListener('click', performCheckout);

  // ---- Mobile sticky checkout bar visibility ----
  // Shown only once the in-panel checkout button has scrolled out of view,
  // so the purchasing action is never duplicated on screen at once. CSS
  // additionally hides the bar entirely above the mobile breakpoint.

  const stickyBar = document.getElementById('sticky-checkout-bar');
  const orderSummaryPanel = document.getElementById('order-summary');
  let panelIntersecting = true;

  function hideStickyBar(): void {
    if (!stickyBar) return;
    stickyBar.classList.remove('is-shown');
    stickyBar.setAttribute('aria-hidden', 'true');
  }

  function updateStickyVisibility(): void {
    if (!stickyBar || !summarySection) return;
    const cartHasItems = !summarySection.hidden;
    if (cartHasItems && !panelIntersecting) {
      stickyBar.classList.add('is-shown');
      stickyBar.setAttribute('aria-hidden', 'false');
    } else {
      hideStickyBar();
    }
  }

  if (orderSummaryPanel && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        panelIntersecting = entry.isIntersecting;
        updateStickyVisibility();
      },
      { threshold: 0 },
    );
    observer.observe(orderSummaryPanel);
  }
</script>
