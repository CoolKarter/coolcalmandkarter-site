---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import FeaturedBooks from '../components/FeaturedBooks.astro';
import StorySection from '../components/StorySection.astro';
import TrustSection from '../components/TrustSection.astro';
import FinalCta from '../components/FinalCta.astro';
import { getEntry } from 'astro:content';

// Owner-selected featured trio. "Black, Puerto Rican & Baby" is the
// best seller and always takes the center slot with the visual emphasis —
// in both the hero stage and the Featured Books section.
const bestSellerSlug = 'black-puerto-rican-and-baby';
const featuredSlugs = ['puertorican-boricua-and-baby', bestSellerSlug, 'black-proud-and-baby'];
const featuredBooks = (
  await Promise.all(featuredSlugs.map((slug) => getEntry('books', slug)))
).filter((book) => book !== undefined);
---

<BaseLayout
  title="Cool, Calm & Karter — Books That Feel Like Home"
  description="Cool, Calm & Karter creates beautifully diverse children’s books filled with culture, joy, and love."
  heroNav
>
  <HomeHero books={featuredBooks} />
  <FeaturedBooks books={featuredBooks} highlightId={bestSellerSlug} />
  <StorySection />
  <TrustSection />
  <FinalCta />
</BaseLayout>
