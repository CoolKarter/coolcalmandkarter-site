---
import BaseLayout from '../layouts/BaseLayout.astro';
import { visualAssets } from '../data/visualAssets';

const reasons = [
  { value: 'general', label: 'General Inquiry' },
  { value: 'feedback', label: 'Feedback or Review' },
  { value: 'collab', label: 'Collaboration or Partnership' },
  { value: 'bulk', label: 'Bulk Order / Retail' },
  { value: 'support', label: 'Support or Issue' },
];
---

<BaseLayout
  title="Contact — Cool, Calm & Karter"
  description="Get in touch with Cool, Calm & Karter — general questions, feedback, collaborations, and bulk orders."
>
  <section class="contact-hero" aria-labelledby="contact-heading">
    <img
      class="contact-hero-bg"
      src={visualAssets.backgrounds.storySection}
      alt=""
      aria-hidden="true"
      loading="eager"
      width="1916"
      height="821"
    />
    <div class="contact-hero-scrim" aria-hidden="true"></div>
    <div class="contact-hero-inner">
      <p class="contact-eyebrow">We&rsquo;re Here to Help</p>
      <h1 id="contact-heading" class="section-title">Get in Touch</h1>
    </div>
  </section>

  <section class="contact-main" aria-label="Contact form and information">
    <div class="contact-grid">
      <div class="contact-form-panel">
        <form id="contact-form" novalidate>
          <div class="field">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="reason">Reason for Contact</label>
            <select id="reason" name="reason">
              {reasons.map((r) => <option value={r.value}>{r.label}</option>)}
            </select>
          </div>

          <div class="field">
            <label for="subject">Subject</label>
            <input type="text" id="subject" name="subject" required />
          </div>

          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="6" required></textarea>
          </div>

          <button type="submit" id="submit-button" class="submit-button">Send</button>

          <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>

      <aside class="contact-info-panel" aria-labelledby="contact-info-heading">
        <p class="contact-eyebrow contact-eyebrow--dark">Let&rsquo;s Connect</p>
        <h2 id="contact-info-heading" class="section-title section-title--left">
          How Can We Help?
        </h2>
        <p class="contact-info-copy">
          Whether you have a question, some kind words to share, an idea for
          working together, or a bulk order in mind, we&rsquo;d love to hear from
          you. Pick the option that fits best and send us a message.
        </p>
        <ul class="contact-reasons">
          {reasons.map((r) => <li>{r.label}</li>)}
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---- Masthead: same cloud asset + scrim strategy as Shop/Cart/About,
     kept compact. ---- */

  .contact-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-night);
    padding: clamp(2.25rem, 6vw, 3rem) 1.5rem clamp(2.5rem, 6vw, 3.25rem);
    text-align: center;
    color: #fff;
  }

  .contact-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .contact-hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      165deg,
      rgba(9, 26, 43, 0.88) 0%,
      rgba(15, 44, 64, 0.82) 55%,
      rgba(25, 85, 105, 0.75) 100%
    );
  }

  .contact-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 640px;
    margin: 0 auto;
  }

  .contact-eyebrow {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: #ffdcae;
    margin: 0 0 0.5rem;
  }

  .contact-eyebrow--dark {
    color: var(--color-coral);
  }

  .contact-hero-inner .section-title {
    color: #fff;
    font-size: clamp(1.9rem, 4vw, 2.4rem);
    margin: 0;
  }

  /* ---- Main two-column composition ---- */

  .contact-main {
    /* .contact-main is a flex item of the shared <main> (see tokens.css's
       main { display: flex; flex-direction: column; }). Width is a
       cross-axis property there, governed by align-items: stretch by
       default — but stretch is disabled whenever an item has an auto
       cross-axis margin (margin: 0 auto below), so without an explicit
       width the browser instead sizes this from its own content's
       preferred width, then only caps that with max-width — which is
       what pushed this page wider than the viewport on mobile (see the
       matching fix and full explanation on .product in
       pages/books/[slug].astro). width: 100% restores the intended
       behavior: fill the available width up to max-width, then the auto
       margins center it once the viewport exceeds max-width. */
    width: 100%;
    max-width: 1040px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 3.5rem) 1.5rem 4rem;
  }

  .contact-grid {
    display: grid;
    /* Bare `1fr` is shorthand for `minmax(auto, 1fr)` — the implicit
       `auto` minimum lets .contact-form-panel's content (the widest
       being the "reason" <select>) force this track wider than the
       viewport instead of shrinking to fit it, the same failure mode the
       desktop rule below already avoids with an explicit minmax(0, ...).
       minmax(0, 1fr) applies that same fix to the mobile single column. */
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  /* Form stays the dominant element (wider ratio) and the gap is tightened
     so the two halves read as one connected composition, not two islands. */
  @media (min-width: 860px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }
  }

  .contact-form-panel {
    background: #fff;
    padding: clamp(1.75rem, 4vw, 2.25rem);
    border-radius: 20px;
    box-shadow:
      0 2px 8px rgba(25, 85, 105, 0.06),
      0 26px 48px -30px rgba(25, 85, 105, 0.4);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: left;
  }

  label {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--color-navy);
  }

  input,
  select,
  textarea {
    padding: 0.8rem 0.9rem;
    border: 1px solid rgba(25, 85, 105, 0.2);
    background: var(--color-cream-light);
    border-radius: 10px;
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-navy);
    min-height: 46px;
  }

  textarea {
    min-height: 130px;
    resize: vertical;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--color-navy);
    outline-offset: 1px;
    background: #fff;
  }

  .submit-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-coral);
    color: white;
    padding: 0.9rem;
    border: none;
    border-radius: 999px;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 0.4rem;
    box-shadow:
      0 14px 28px -14px rgba(244, 96, 69, 0.65),
      0 3px 8px rgba(25, 85, 105, 0.2);
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .submit-button:hover:not(:disabled),
  .submit-button:focus-visible:not(:disabled) {
    background-color: var(--color-coral-deep);
    transform: translateY(-1px);
  }

  .submit-button:focus-visible {
    outline: 3px solid var(--color-navy);
    outline-offset: 3px;
  }

  .submit-button:disabled {
    background-color: #ccc;
    color: #555;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
  }

  .form-status {
    margin: 0.25rem 0 0;
    font-weight: 700;
    text-align: center;
    min-height: 1.2em;
    color: var(--color-navy);
  }

  .form-status.success {
    padding: 0.85rem 1.1rem;
    background: var(--color-cream-light);
    border-radius: 10px;
    color: #1a7a3c;
  }

  .form-status.error {
    padding: 0.85rem 1.1rem;
    background: rgba(179, 38, 30, 0.08);
    border-radius: 10px;
    color: #b3261e;
  }

  /* ---- Supporting info panel ---- */

  .contact-info-panel {
    padding: clamp(1.5rem, 4vw, 2rem) 0.25rem 0 0;
  }

  @media (min-width: 860px) {
    .contact-info-panel {
      padding-top: clamp(1.75rem, 4vw, 2.25rem);
    }
  }

  .contact-info-panel .section-title {
    color: var(--color-navy);
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
    margin: 0 0 0.9rem;
  }

  .contact-info-copy {
    font-size: 1rem;
    line-height: 1.7;
    color: #4a4a4a;
    margin: 0 0 1.5rem;
  }

  .contact-reasons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-reasons li {
    position: relative;
    padding-left: 1.4rem;
    font-weight: 700;
    color: var(--color-navy);
    font-size: 0.98rem;
  }

  .contact-reasons li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-coral);
  }

  @media (max-width: 859px) {
    .contact-info-panel {
      text-align: center;
    }

    .contact-info-panel .section-title::after {
      margin-inline: auto;
    }

    .contact-reasons {
      align-items: center;
    }

    .contact-reasons li {
      padding-left: 1.2rem;
    }
  }
</style>

<script>
  import { submitContactForm } from '../lib/api';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
  const status = document.getElementById('form-status') as HTMLParagraphElement;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    submitButton.disabled = true;
    submitButton.textContent = 'Sending…';
    status.textContent = '';
    status.classList.remove('success', 'error');

    const formData = new FormData(form);
    const payload = {
      name: String(formData.get('name') ?? ''),
      email: String(formData.get('email') ?? ''),
      reason: String(formData.get('reason') ?? ''),
      subject: String(formData.get('subject') ?? ''),
      message: String(formData.get('message') ?? ''),
    };

    try {
      await submitContactForm(payload);
      status.textContent = 'Thank you! Your message has been sent.';
      status.classList.add('success');
      form.reset();
    } catch (error) {
      status.textContent =
        error instanceof Error ? error.message : 'Something went wrong. Please try again.';
      status.classList.add('error');
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Send';
    }
  });
</script>
