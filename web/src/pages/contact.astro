---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Cool, Calm & Karter"
  description="Get in touch with Cool, Calm & Karter — general questions, feedback, collaborations, and bulk orders."
>
  <section class="contact" aria-labelledby="contact-heading">
    <h1 id="contact-heading">Contact</h1>

    <form id="contact-form" novalidate>
      <div class="field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" autocomplete="name" required />
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email" required />
      </div>

      <div class="field">
        <label for="reason">Reason for Contact</label>
        <select id="reason" name="reason">
          <option value="general">General Inquiry</option>
          <option value="feedback">Feedback or Review</option>
          <option value="collab">Collaboration or Partnership</option>
          <option value="bulk">Bulk Order / Retail</option>
          <option value="support">Support or Issue</option>
        </select>
      </div>

      <div class="field">
        <label for="subject">Subject</label>
        <input type="text" id="subject" name="subject" required />
      </div>

      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" required></textarea>
      </div>

      <button type="submit" id="submit-button">Send</button>

      <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</BaseLayout>

<style>
  .contact {
    max-width: 560px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .contact h1 {
    text-align: center;
    font-family: var(--font-display);
    color: var(--color-coral);
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: #fff;
    padding: 2rem;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-align: left;
  }

  label {
    font-weight: 700;
    font-size: 0.95rem;
  }

  input,
  select,
  textarea {
    padding: 0.7rem;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-family: var(--font-body);
    font-size: 1rem;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--color-navy);
    outline-offset: 1px;
  }

  textarea {
    resize: vertical;
    min-height: 120px;
  }

  button {
    background-color: var(--color-coral);
    color: white;
    padding: 0.85rem;
    border: none;
    border-radius: 10px;
    font-size: 1.05rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 0.5rem;
    transition: background-color 0.15s ease;
  }

  button:hover:not(:disabled),
  button:focus-visible:not(:disabled) {
    background-color: #d94c36;
  }

  button:disabled {
    background-color: #ccc;
    cursor: not-allowed;
  }

  .form-status {
    margin: 0;
    font-weight: 700;
    text-align: center;
    min-height: 1.2em;
  }

  .form-status.success {
    color: #1a7a3c;
  }

  .form-status.error {
    color: #b3261e;
  }
</style>

<script>
  import { submitContactForm } from '../lib/api';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
  const status = document.getElementById('form-status') as HTMLParagraphElement;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();

    submitButton.disabled = true;
    submitButton.textContent = 'Sending…';
    status.textContent = '';
    status.classList.remove('success', 'error');

    const formData = new FormData(form);
    const payload = {
      name: String(formData.get('name') ?? ''),
      email: String(formData.get('email') ?? ''),
      reason: String(formData.get('reason') ?? ''),
      subject: String(formData.get('subject') ?? ''),
      message: String(formData.get('message') ?? ''),
    };

    try {
      await submitContactForm(payload);
      status.textContent = 'Thank you! Your message has been sent.';
      status.classList.add('success');
      form.reset();
    } catch (error) {
      status.textContent =
        error instanceof Error ? error.message : 'Something went wrong. Please try again.';
      status.classList.add('error');
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = 'Send';
    }
  });
</script>
