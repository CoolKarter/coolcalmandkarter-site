---
import BaseLayout from '../layouts/BaseLayout.astro';
import { visualAssets } from '../data/visualAssets';
---

<BaseLayout
  title="Page Not Found — Cool, Calm & Karter"
  description="The page you're looking for couldn't be found."
>
  <section class="not-found" aria-labelledby="not-found-heading">
    <img
      class="not-found-bg"
      src={visualAssets.backgrounds.storySection}
      alt=""
      aria-hidden="true"
      loading="eager"
      width="1916"
      height="821"
    />
    <div class="not-found-scrim" aria-hidden="true"></div>

    <div class="not-found-card">
      <img
        class="not-found-karter"
        src={visualAssets.characters.peeking}
        alt=""
        aria-hidden="true"
        loading="eager"
        width="1024"
        height="1536"
      />
      <img
        class="not-found-logo"
        src={visualAssets.logos.cloudMark}
        alt=""
        aria-hidden="true"
        loading="eager"
        width="930"
        height="420"
      />
      <p class="not-found-eyebrow">Oops!</p>
      <h1 id="not-found-heading" class="section-title">Page Not Found</h1>
      <p class="not-found-copy">
        Looks like you took a wrong turn. Let&rsquo;s head back to where the magic
        happens.
      </p>
      <div class="not-found-links">
        <a class="cta-button" href="/">Back to Home</a>
        <a class="cta-button cta-button--ghost" href="/shop">Browse the Shop</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* flex:1 fills all of main's leftover viewport height (main is the flex
     column this grows within, same mechanism as Success/Cancel), so the
     card centers within the true available space instead of a fixed
     min-height leaving a blank cream gap before the footer. */
  .not-found {
    position: relative;
    overflow: hidden;
    flex: 1 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(420px, 55vh, 560px);
    padding: clamp(3rem, 8vw, 4.5rem) 1.5rem;
    background-color: var(--color-night);
  }

  .not-found-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .not-found-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      165deg,
      rgba(9, 26, 43, 0.82) 0%,
      rgba(15, 44, 64, 0.72) 55%,
      rgba(25, 85, 105, 0.62) 100%
    );
  }

  .not-found-card {
    position: relative;
    z-index: 1;
    overflow: visible;
    text-align: center;
    background: #fff;
    max-width: 30rem;
    width: 100%;
    padding: clamp(2.25rem, 6vw, 3rem) 1.75rem clamp(2rem, 5vw, 2.5rem);
    border-radius: 20px;
    box-shadow:
      0 10px 30px rgba(4, 10, 18, 0.35),
      0 26px 48px -20px rgba(4, 10, 18, 0.45);
  }

  .not-found-logo {
    height: 40px;
    width: auto;
    margin: 0 0 1rem;
  }

  /* Peeking in from the outer corner — never over the text or buttons. */
  .not-found-karter {
    position: absolute;
    top: -2.5rem;
    left: -1.5rem;
    width: clamp(72px, 11vw, 100px);
    height: auto;
    pointer-events: none;
  }

  @media (max-width: 480px) {
    .not-found-karter {
      top: -1.9rem;
      left: -1rem;
      width: 68px;
    }
  }

  .not-found-eyebrow {
    font-family: var(--font-display);
    color: var(--color-coral);
    font-size: 1.1rem;
    margin: 0 0 0.4rem;
  }

  .not-found-card .section-title {
    color: var(--color-navy);
    font-size: clamp(1.9rem, 4vw, 2.4rem);
    margin: 0 0 0.9rem;
  }

  .not-found-copy {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #4a4a4a;
    max-width: 24rem;
    margin: 0 auto 1.75rem;
  }

  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: #fff;
    background-color: var(--color-coral);
    padding: 0.7rem 1.9rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow:
      0 14px 28px -14px rgba(244, 96, 69, 0.65),
      0 3px 8px rgba(25, 85, 105, 0.2);
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .cta-button:hover,
  .cta-button:focus-visible {
    background-color: var(--color-coral-deep);
    transform: translateY(-1px);
  }

  .cta-button--ghost {
    background-color: transparent;
    color: var(--color-navy);
    border: 2px solid rgba(25, 85, 105, 0.3);
    box-shadow: none;
  }

  .cta-button--ghost:hover,
  .cta-button--ghost:focus-visible {
    background-color: rgba(25, 85, 105, 0.06);
    color: var(--color-navy);
  }

  .cta-button:focus-visible {
    outline: 3px solid var(--color-navy);
    outline-offset: 3px;
  }
</style>
