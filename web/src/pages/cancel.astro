---
import BaseLayout from '../layouts/BaseLayout.astro';
import { visualAssets } from '../data/visualAssets';
---

<BaseLayout
  title="Checkout Canceled — Cool, Calm & Karter"
  description="Your checkout was canceled. Your cart is unchanged."
>
  <section class="return-hero" aria-hidden="true">
    <img
      class="return-bg"
      src={visualAssets.backgrounds.storySection}
      alt=""
      loading="eager"
      width="1916"
      height="821"
    />
    <div class="return-scrim"></div>
  </section>

  <section class="checkout-return" aria-labelledby="cancel-heading">
    <div class="return-panel">
      <p class="return-eyebrow">No rush</p>
      <h1 id="cancel-heading" class="section-title">Your Cart Is Still Here</h1>
      <p class="status-text" role="status">
        Checkout wasn&rsquo;t completed and no order was placed &mdash; your books are exactly
        as you left them.
      </p>

      <nav class="return-links" aria-label="Continue shopping">
        <a class="cta-button" href="/cart">Return to Cart</a>
        <a class="cta-button cta-button--ghost" href="/shop">Continue Shopping</a>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  /* Compact atmospheric masthead — same cloud asset + scrim strategy as
     Shop/Cart. No text lives in this band; it stays its own section,
     never touched by the card in the cream area below. */
  .return-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-night);
    min-height: clamp(90px, 12vw, 125px);
  }

  .return-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }

  .return-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      165deg,
      rgba(9, 26, 43, 0.82) 0%,
      rgba(15, 44, 64, 0.72) 55%,
      rgba(25, 85, 105, 0.62) 100%
    );
  }

  /* Cream working area — never touches the hero above it. flex:1 lets it
     absorb any leftover viewport height (main is the flex column this
     grows within); the card centers vertically within this region via
     `margin: auto` on a column-flex item. */
  .checkout-return {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 5vw, 2.75rem) 1.5rem 4rem;
    text-align: center;
  }

  .return-panel {
    position: relative;
    background: #fff;
    max-width: 560px;
    margin: auto auto;
    border-radius: 20px;
    padding: clamp(2.25rem, 6vw, 3rem) 1.75rem clamp(2rem, 5vw, 2.5rem);
    box-shadow:
      0 10px 30px rgba(4, 10, 18, 0.35),
      0 26px 48px -20px rgba(4, 10, 18, 0.45);
  }

  .return-eyebrow {
    font-family: var(--font-display);
    color: var(--color-coral);
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
  }

  .checkout-return h1.section-title {
    color: var(--color-navy);
    font-size: clamp(1.75rem, 3.6vw, 2.2rem);
    margin: 0 0 1.1rem;
  }

  .status-text {
    background: var(--color-cream-light);
    border-radius: 12px;
    padding: 1.1rem 1.4rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 2rem;
  }

  .return-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: #fff;
    background-color: var(--color-coral);
    padding: 0.7rem 1.9rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow:
      0 14px 28px -14px rgba(244, 96, 69, 0.65),
      0 3px 8px rgba(25, 85, 105, 0.2);
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }

  .cta-button:hover,
  .cta-button:focus-visible {
    background-color: var(--color-coral-deep);
    transform: translateY(-1px);
  }

  .cta-button--ghost {
    background-color: transparent;
    color: var(--color-navy);
    border: 2px solid rgba(25, 85, 105, 0.3);
    box-shadow: none;
  }

  .cta-button--ghost:hover,
  .cta-button--ghost:focus-visible {
    background-color: rgba(25, 85, 105, 0.06);
    color: var(--color-navy);
  }

  .cta-button:focus-visible {
    outline: 3px solid var(--color-navy);
    outline-offset: 3px;
  }
</style>
