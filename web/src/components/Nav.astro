---
const links = [
  { href: '/', label: 'Home' },
  { href: '/shop', label: 'Shop' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-nav">
  <a class="brand" href="/">Cool, Calm &amp; Karter</a>
  <nav aria-label="Primary">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="cart-link" href="/cart" aria-label="View cart">
      <span aria-hidden="true">🛒</span>
      <span class="cart-count" id="cart-count">0</span>
    </a>
  </nav>
</header>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background-color: var(--color-navy);
    font-family: var(--font-body);
  }

  .brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    color: white;
    text-decoration: none;
  }

  nav[aria-label='Primary'] {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  nav[aria-label='Primary'] a {
    color: white;
    text-decoration: none;
    font-weight: 700;
  }

  nav[aria-label='Primary'] a:hover,
  nav[aria-label='Primary'] a:focus-visible {
    text-decoration: underline;
  }

  .cart-link {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .cart-count {
    position: absolute;
    top: -0.6rem;
    right: -0.75rem;
    background-color: var(--color-coral);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
  }
</style>

<script>
  import { getCartCount, CART_UPDATED_EVENT, CART_STORAGE_KEY } from '../lib/cart';

  function updateCartBadge() {
    const el = document.getElementById('cart-count');
    if (el) el.textContent = String(getCartCount());
  }

  updateCartBadge();
  window.addEventListener(CART_UPDATED_EVENT, updateCartBadge);
  window.addEventListener('storage', (event) => {
    if (event.key === CART_STORAGE_KEY) updateCartBadge();
  });
</script>
