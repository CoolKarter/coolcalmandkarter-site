---
import { visualAssets } from '../data/visualAssets';

interface Props {
  /**
   * When true (homepage hero), the nav floats transparently over the top of
   * the cinematic hero artwork with a soft dark scrim for readability.
   * Default is the solid navy bar used by every other page.
   */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const links = [
  { href: '/', label: 'Home' },
  { href: '/shop', label: 'Shop' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<header class:list={['site-nav', { 'site-nav--overlay': overlay }]}>
  <a class="brand" href="/">
    <img
      src={visualAssets.logos.cloudMark}
      alt="Cool, Calm & Karter — home"
      width="930"
      height="420"
      decoding="async"
    />
  </a>
  <nav aria-label="Primary">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <a class="cart-link" href="/cart" aria-label="View cart">
      <img class="cart-icon" src={visualAssets.ui.cartIcon} alt="" width="1024" height="1024" />
      <span class="cart-count" id="cart-count">0</span>
    </a>
  </nav>
</header>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    padding: 0.75rem 1.5rem;
    background-color: var(--color-navy);
    font-family: var(--font-body);
  }

  .site-nav--overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    background-color: transparent;
    background-image: linear-gradient(
      to bottom,
      rgba(9, 26, 43, 0.62),
      rgba(9, 26, 43, 0.28) 70%,
      transparent
    );
    padding-bottom: 1.4rem;
  }

  /* Cloud-only brand symbol, sitting directly on the nav/hero background
     with a soft lift shadow + faint cream glow — the teal clouds read
     clearly on both the navy bar and the dark hero sky without any chip. */
  .brand {
    display: inline-flex;
    align-items: center;
    border-radius: 12px;
    transition: transform 0.2s ease;
  }

  .brand:hover {
    transform: translateY(-1px);
  }

  .brand img {
    height: 48px;
    width: auto;
    display: block;
    filter: drop-shadow(0 2px 8px rgba(9, 26, 43, 0.55))
      drop-shadow(0 0 14px rgba(255, 246, 222, 0.35));
  }

  nav[aria-label='Primary'] {
    display: flex;
    align-items: center;
    gap: 0.4rem 1.35rem;
    flex-wrap: wrap;
  }

  nav[aria-label='Primary'] a {
    color: white;
    text-decoration: none;
    font-weight: 700;
    text-shadow: 0 1px 8px rgba(9, 26, 43, 0.45);
    border-radius: 6px;
    padding: 0.15rem 0.1rem;
  }

  nav[aria-label='Primary'] a:hover,
  nav[aria-label='Primary'] a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-coral);
  }

  .site-nav a:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .cart-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-cream-light);
    box-shadow: 0 2px 8px rgba(9, 26, 43, 0.35);
  }

  .cart-icon {
    width: 26px;
    height: 26px;
    display: block;
  }

  .cart-count {
    position: absolute;
    top: -0.45rem;
    right: -0.65rem;
    background-color: var(--color-coral);
    color: white;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
  }

  @media (max-width: 640px) {
    .brand img {
      height: 40px;
    }
  }
</style>

<script>
  import { getCartCount, CART_UPDATED_EVENT, CART_STORAGE_KEY } from '../lib/cart';

  function updateCartBadge() {
    const el = document.getElementById('cart-count');
    if (el) el.textContent = String(getCartCount());
  }

  updateCartBadge();
  window.addEventListener(CART_UPDATED_EVENT, updateCartBadge);
  window.addEventListener('storage', (event) => {
    if (event.key === CART_STORAGE_KEY) updateCartBadge();
  });
</script>
