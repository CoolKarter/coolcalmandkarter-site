---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { resolveCoverImage } from '../lib/images';

interface Props {
  book: CollectionEntry<'books'>;
}

const { book } = Astro.props;
const { data } = book;
const cover = resolveCoverImage(data.coverImage);
const priceDisplay = data.price != null ? `$${(data.price / 100).toFixed(2)}` : null;
const isAvailable = data.availability === 'available';
---

<a class="book-card" href={`/books/${book.id}`}>
  <div class="cover-frame">
    <Image src={cover} alt={data.coverImageAlt} width={500} loading="lazy" />
  </div>
  <div class="book-card-body">
    <h2 class="book-title">{data.title}</h2>
    {data.shortDescription && <p class="book-blurb">{data.shortDescription}</p>}
    <div class="book-meta">
      {priceDisplay && <span class="book-price">{priceDisplay}</span>}
      {data.ageRange && <span class="book-age">Ages {data.ageRange}</span>}
      <span class={`book-availability ${isAvailable ? 'is-available' : 'is-coming-soon'}`}>
        {isAvailable ? 'Available' : 'Coming Soon'}
      </span>
    </div>
  </div>
</a>

<style>
  .book-card {
    display: flex;
    flex-direction: column;
    background: #fffaf0;
    border: 1px solid rgba(25, 85, 105, 0.12);
    border-radius: 14px;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }

  .book-card:hover,
  .book-card:focus-visible {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
  }

  .book-card .cover-frame {
    max-width: 280px;
    margin: 0 auto 1rem;
    width: 100%;
  }

  .book-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .book-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    color: var(--color-navy);
    margin: 0 0 0.5rem;
  }

  .book-blurb {
    font-size: 0.9rem;
    color: #444;
    line-height: 1.5;
    margin: 0 0 1rem;
    flex: 1;
  }

  .book-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
  }

  .book-price {
    font-weight: 700;
    color: var(--color-navy);
  }

  .book-age {
    color: #555;
  }

  .book-availability {
    margin-left: auto;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.75rem;
  }

  .book-availability.is-available {
    background: rgba(25, 85, 105, 0.1);
    color: var(--color-navy);
  }

  .book-availability.is-coming-soon {
    background: rgba(244, 96, 69, 0.1);
    color: var(--color-coral);
  }
</style>
