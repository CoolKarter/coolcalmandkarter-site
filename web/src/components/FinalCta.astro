---
import { visualAssets } from '../data/visualAssets';
---

<section class="final-cta" aria-labelledby="cta-heading">
  <img
    class="cta-bg"
    src={visualAssets.backgrounds.finalCta}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    width="1916"
    height="821"
  />

  <div class="cta-inner">
    <p class="cta-eyebrow">the adventure is just beginning</p>
    <h2 id="cta-heading" class="section-title">
      Make Tonight&rsquo;s Story One They&rsquo;ll Remember
    </h2>
    <p class="cta-sub">
      Explore the collection of Baby Karter adventures — and find the story your
      little one will ask for again and again.
    </p>
    <a class="cta-button" href="/shop">Explore the Collection</a>
  </div>

  <img
    class="cta-karter"
    src={visualAssets.characters.pointing}
    alt="Baby Karter pointing up toward the collection"
    loading="lazy"
    decoding="async"
    width="1024"
    height="1024"
  />
</section>

<style>
  .final-cta {
    position: relative;
    overflow: hidden;
    background-color: var(--color-night);
    color: #fff;
    padding: clamp(4.5rem, 11vw, 8rem) 1.5rem;
    text-align: center;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    max-width: 46rem;
    margin: 0 auto;
  }

  .cta-eyebrow {
    font-family: var(--font-display);
    color: #ffd9a8;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    margin: 0 0 0.9rem;
    text-shadow: 0 2px 14px rgba(5, 15, 28, 0.8);
  }

  .final-cta h2 {
    font-size: clamp(2.1rem, 4.4vw, 3.2rem);
    line-height: 1.1;
    margin: 0 0 1.1rem;
    text-shadow: 0 3px 24px rgba(5, 15, 28, 0.75);
  }

  .cta-sub {
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.65;
    margin: 0 auto 2rem;
    max-width: 34rem;
    text-shadow: 0 2px 14px rgba(5, 15, 28, 0.85);
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    color: #fff;
    background-color: var(--color-coral);
    padding: 0.85rem 2.3rem;
    border-radius: 999px;
    text-decoration: none;
    box-shadow:
      0 16px 34px -12px rgba(244, 96, 69, 0.6),
      0 4px 12px rgba(5, 15, 28, 0.5);
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .cta-button:hover,
  .cta-button:focus-visible {
    background-color: var(--color-coral-deep);
  }

  .cta-button:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .cta-karter {
    position: absolute;
    right: clamp(-30px, 2vw, 70px);
    bottom: -3%;
    width: clamp(150px, 17vw, 250px);
    height: auto;
    z-index: 1;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cta-karter {
      animation: gentle-float 7.5s ease-in-out infinite alternate;
    }

    .cta-button:hover {
      transform: translateY(-2px);
    }
  }

  @keyframes gentle-float {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 -8px;
    }
  }

  @media (max-width: 720px) {
    .final-cta {
      padding-bottom: clamp(11rem, 40vw, 14rem);
    }

    .cta-karter {
      right: 50%;
      transform: translateX(50%);
      bottom: -2%;
      width: clamp(140px, 34vw, 180px);
    }
  }
</style>
