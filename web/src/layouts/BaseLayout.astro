---
import '../styles/tokens.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Homepage only: float the nav transparently over the cinematic hero. */
  heroNav?: boolean;
  /** For public pages that shouldn't appear in search results (e.g. the magic-link verify utility page) without being fully private like /admin. */
  noindex?: boolean;
}

const {
  title,
  description = 'Cool, Calm & Karter — books that feel like home.',
  heroNav = false,
  noindex = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Pacifico&family=Baloo+2:wght@400;700&family=Nunito:wght@400;700&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap"
    />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <Nav overlay={heroNav} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
