# Base URL of the Express API (server/server.js), used by client-side fetch
# calls instead of hardcoding the Render URL in page code.
PUBLIC_API_BASE_URL=https://coolcalmandkarter-site.onrender.com

# Store-wide checkout kill-switch — controls CUSTOMER-FACING purchase UI
# only (product-page purchase controls, the Shop "Out of Stock" badge, the
# cart Checkout button). This is a BUILD-TIME value (Astro/Vite bakes
# PUBLIC_-prefixed variables into the static output), so changing it
# requires a full rebuild/redeploy — a Netlify env var change alone does
# nothing until the next build runs.
#
# This is NEVER the actual security/business boundary: the backend's own
# STORE_CHECKOUT_ENABLED (see server/.env.example) independently refuses
# to create a Stripe Checkout Session regardless of what this says, so a
# mismatched frontend=true/backend=false configuration still safely
# blocks purchasing — just with a less polished (but still correct and
# on-brand) error message instead of a disabled button. Never rely on this
# variable alone for enforcement.
#
# Fails closed, same rule as the backend: only the exact string "true"
# enables checkout UI (see web/src/lib/store-status.js).
#
#   staging                                  -> PUBLIC_STORE_CHECKOUT_ENABLED=true
#   production (inventory at zero, right now) -> PUBLIC_STORE_CHECKOUT_ENABLED=false
#   production (once inventory returns)       -> PUBLIC_STORE_CHECKOUT_ENABLED=true
#
# Defaults to false here (same fail-closed spirit as server/.env.example) —
# a fresh local checkout of this file never enables real purchasing UI
# without an explicit, deliberate override.
PUBLIC_STORE_CHECKOUT_ENABLED=false
