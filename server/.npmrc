# This project lives on an exFAT-formatted drive, which does not support
# POSIX symlinks. npm's default node_modules/.bin symlinks fail on exFAT
# (EPERM on symlink), so bin-linking is disabled here. Run CLI tools via
# `npm run <script>` (see package.json) instead of relying on
# node_modules/.bin/<cmd>.
bin-links=false
