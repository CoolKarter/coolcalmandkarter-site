# Copy this file to server/.env for local development.
# Never commit real values — this file must only ever contain placeholders.

# --- Stripe ---
# Use a test-mode key (sk_test_...) for local/staging, live-mode (sk_live_...) only in production.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- MongoDB ---
# Use a distinct database name per environment so test orders never mix with production orders.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority

# --- Frontend ---
# Base URL of the deployed Astro frontend for this environment. No trailing
# slash required (it's normalized). Used to build Stripe success/cancel
# redirect URLs — there is no hardcoded fallback, so this must be set.
FRONTEND_BASE_URL=http://localhost:4321

# --- Admin dashboard (existing Basic Auth; unrelated to checkout) ---
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# --- Outbound email (Resend) ---
# EMAIL_FROM must be a sender address on a domain verified in the Resend
# dashboard (e.g. "Cool, Calm & Karter <orders@coolcalmandkarter.com>").
RESEND_API_KEY=re_placeholder
EMAIL_FROM="Cool, Calm & Karter <orders@example.com>"

# --- Legacy outbound email (Nodemailer via Gmail) — no longer read by any
# code path as of the Resend migration. Kept here only because the
# corresponding Render env vars are being kept for now, until staging
# verifies Resend end-to-end; safe to delete once that's confirmed. ---
EMAIL_USERNAME=your-address@example.com
EMAIL_PASSWORD=your-app-password

# --- Server port (optional — Render sets this automatically) ---
PORT=3000

# --- Stripe Price IDs, one per book ---
# A book is unavailable for checkout until its variable is set. Use
# test-mode Price IDs (price_...) for staging, live-mode Price IDs for
# production — never reuse a live Price ID with a test-mode secret key or
# vice versa.
STRIPE_PRICE_FLORIDA_BEACH_AND_BABY=price_placeholder
STRIPE_PRICE_BLACK_BEAUTIFUL_AND_BABY=price_placeholder
STRIPE_PRICE_BLACK_PUERTO_RICAN_AND_BABY=price_placeholder
STRIPE_PRICE_ADVENTURE_FUN_AND_BABY=price_placeholder
STRIPE_PRICE_GO_TO_SLEEP_KARTER=price_placeholder
STRIPE_PRICE_ABUELITA_AND_BABY=price_placeholder
STRIPE_PRICE_BLACK_WHITE_AND_BABY=price_placeholder
STRIPE_PRICE_CHRISTMAS_AND_BABY=price_placeholder
STRIPE_PRICE_HALLOWEEN_AND_BABY=price_placeholder
STRIPE_PRICE_MEXICAN_AND_BABY=price_placeholder
STRIPE_PRICE_PUERTORICAN_BORICUA_AND_BABY=price_placeholder
STRIPE_PRICE_THANKSGIVING_AND_BABY=price_placeholder
